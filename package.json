{
  "name": "mock-brevo-tooling",
  "private": true,
  "description": "Lint and browser-test tooling for the static admin UI and docs. Not needed to build or run mock-brevo.",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "lint": "npm run lint:js && npm run lint:html && npm run lint:css && npm run lint:md",
    "lint:js": "eslint",
    "lint:html": "htmlhint \"src/main/resources/static/**/*.html\"",
    "lint:css": "stylelint \"src/main/resources/static/**/*.css\"",
    "lint:md": "markdownlint-cli2",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "htmlhint": "^1.9.2",
    "markdownlint-cli2": "^0.24.2",
    "stylelint": "^18.1.0",
    "stylelint-config-recommended": "^19.1.0"
  },
  "overrides": {
    "glob": "^14.0.3",
    "katex": "^0.18.2",
    "minimatch": "^11.0.4",
    "re2js": "^2.8.7"
  }
}
