{
  "name": "mock-brevo-tooling",
  "private": true,
  "description": "Lint and browser-test tooling for the static admin UI and docs. Not needed to build or run mock-brevo.",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:html && npm run lint:css && npm run lint:md",
    "lint:js": "eslint",
    "lint:html": "htmlhint \"src/main/resources/static/**/*.html\"",
    "lint:css": "stylelint \"src/main/resources/static/**/*.css\"",
    "lint:md": "markdownlint-cli2",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "htmlhint": "^1.9.2",
    "markdownlint-cli2": "^0.23.3",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0"
  }
}
